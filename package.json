{
  "name": "phlant",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Comparative moon & tradition planting almanac: seven planting traditions scored from real ephemeris for any place on Earth, with soil survey, frost statistics, wind rose, a 2D/3D garden planner and offline site packs.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3917 --strictPort",
    "build": "npm run typecheck && NODE_OPTIONS=--experimental-global-webcrypto vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3510 --strictPort",
    "test": "vitest run",
    "cap:init": "npx cap init phlant org.robbiemed.phlant --web-dir dist",
    "cap:android": "npx cap add android && npx cap sync android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "docs:traditions": "vite-node scripts/gen-traditions-doc.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "homepage": "https://phlant.robbiemed.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbie-med/phlant.git"
  },
  "bugs": {
    "url": "https://github.com/robbie-med/phlant/issues"
  },
  "license": "MIT",
  "author": "robbie-med",
  "keywords": [
    "gardening",
    "moon",
    "lunar-calendar",
    "biodynamic",
    "solar-terms",
    "almanac",
    "astronomy",
    "pwa",
    "ssurgo",
    "korean",
    "chinese-calendar"
  ],
  "engines": {
    "node": ">=18.17"
  }
}
