{
  "name": "phlant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Comparative moon-planting almanac: Korean, Chinese, biodynamic, French, Russian, English & American Northeast traditions computed from real ephemeris, plus garden layout and companion planting.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3917 --strictPort",
    "build": "tsc --noEmit && NODE_OPTIONS=--experimental-global-webcrypto vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3510 --strictPort",
    "test": "vitest run",
    "cap:init": "npx cap init phlant org.robbiemed.phlant --web-dir dist",
    "cap:android": "npx cap add android && npx cap sync android"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
